---
import BaseLayout from '../layouts/BaseLayout.astro'

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'ホーム',
			item: Astro.site?.toString() || '',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'WordPressの保守',
			item: new URL('/maintenance/', Astro.site).toString(),
		},
	],
}

const mailHref = 'mailto:info@wadahide.com?subject=WordPress保守のご相談'
const recoveryHref = 'https://coconala.com/services/2970257'
---

<BaseLayout
	title="WordPressの保守"
	description="WordPressの本体・プラグインの更新を、テストサイトで確かめてから本番に反映します。更新で表示が崩れたら直すところまで含めて、1サイト月額11,000円（税込）。作った業者と連絡がつかない、更新が止まっているサイトの保守を承ります。"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	/>
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-2 font-bold">WordPressの保守</h1>
	</main>
	<section class="app-container py-12 mb-8">
		<div
			class="prose prose-neutral prose-lg md:prose-xl dark:prose-invert max-w-none"
		>
			<p class="text-2xl font-medium mb-6">
				更新して、崩れたら直すところまでお引き受けします。
			</p>

			<h2 class="text-3xl font-bold mt-12 mb-6">こんな方へ</h2>
			<ul class="mb-6">
				<li>サイトを作った業者と連絡がつかない、または契約が終わっている</li>
				<li>WordPressやプラグインの更新が、何年も止まったままになっている</li>
				<li>更新したいが、表示が崩れるのが怖くてボタンを押せない</li>
			</ul>

			<h2 class="text-3xl font-bold mt-12 mb-6">毎月やること</h2>
			<ul class="mb-6">
				<li>
					<strong>更新</strong> — WordPress本体・プラグインの版を点検し、更新します
				</li>
				<li>
					<strong>テストサイトでの確認</strong> — 先にテストサイトで更新し、表示が崩れないことを確かめてから本番に反映します。崩れた場合は直します
				</li>
				<li>
					<strong>バックアップの確認</strong> — 自動バックアップが取れているかを確かめます
				</li>
				<li>
					<strong>重大な弱点が公表されたとき</strong> — その日のうちに確認し、必要なら更新します
				</li>
			</ul>

			<h2 class="text-3xl font-bold mt-12 mb-6">料金</h2>
			<ul class="mb-6">
				<li><strong>月額 11,000円（税込）</strong> / 1サイト</li>
				<li>
					<strong>初回の守りの導入 33,000円（税込）</strong> / 1サイト・一式
				</li>
			</ul>
			<p class="mb-6">初回の守りの導入で行うこと:</p>
			<ul class="mb-6">
				<li>毎月の更新の確認に使うテストサイトを作る</li>
				<li>管理画面の手前に、もう1枚の鍵（Basic認証）をかける</li>
				<li>ログイン名が外から分かる状態を止める</li>
				<li>攻撃の入口になりやすい機能（xmlrpc）を閉じる</li>
				<li>サーバー側の防御（WAF）を有効にする</li>
				<li>バックアップが自動で取れるように設定する</li>
			</ul>
			<p class="mb-6">
				「直す」の範囲は、更新によって崩れた部分です。デザインの変更や機能の追加は、別にお見積もりします。
			</p>

			<h2 class="text-3xl font-bold mt-12 mb-6">
				いま、サイトが壊れている場合
			</h2>
			<p class="mb-6">
				画面が真っ白になった、ログインできない、改ざんされたなど、すぐに直す必要がある場合は、<a
					href={recoveryHref}
					target="_blank"
					rel="noopener">こちらの復旧対応</a
				>からご相談ください。
			</p>

			<h2 class="text-3xl font-bold mt-12 mb-6">ご相談</h2>
			<p class="mb-6">
				<a href={mailHref}>info@wadahide.com</a
				>まで、サイトのURLと、いまお困りのことをお送りください。
			</p>
		</div>
	</section>
</BaseLayout>
